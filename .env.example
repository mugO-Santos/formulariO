# Chave secreta do Flask (gere uma string aleatória forte em produção)
SECRET_KEY=troque-por-uma-chave-segura

# URL do banco de dados
# SQLite local (desenvolvimento):
# DATABASE_URL=sqlite:///formulario.db
# PostgreSQL Neon (produção):
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

DATABASE_URL=sqlite:///formulario.db

# Credenciais do Admin inicial (criado na primeira execução)
ADMIN_USER=admin
ADMIN_PASS=troque-por-uma-senha-forte
